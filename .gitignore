# Secrets and local configuration (never commit)
.env
.env.*
!.env.example

# Certificates and keys (local CA for the HTTPS block page)
certs/
*.pem
*.key
*.crt
*.csr

# Raw datasets (large, third-party licenses)
data/raw/*
!data/raw/.gitkeep

# Processed datasets (derived from third-party feeds, regenerate with ml/prepare_data.py)
data/processed/*
!data/processed/.gitkeep

# Databases and logs
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.log

# Visual check: official screenshots, their hashes and evaluation screenshots are
# made locally (python -m ml.visual.reference_hashes); only references.txt is committed
data/references/*
!data/references/references.txt
data/visual_eval/

# Trained models are reproducible from train.py
ml/models/*.joblib
ml/models/*.pkl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
